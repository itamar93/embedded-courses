# Where the build-and-run service listens (services/runner)
PUBLIC_RUNNER_URL=http://localhost:8080
# Cloudflare Web Analytics site token (visits, pages, referrers). Leave empty to disable.
PUBLIC_CF_ANALYTICS_TOKEN=
# PostHog project key and host (course funnel events). Leave empty to disable.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
