---
import Base from '../../../layouts/Base.astro';
import { getCourses } from '../../../lib/courses';

export function getStaticPaths() {
  return getCourses().map((course) => ({ params: { course: course.id }, props: { course } }));
}

const { course } = Astro.props;
---
<Base title={course.title} description={course.summary}>
  <section class="py-16">
    <p class="font-mono text-sm text-accent">course</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-white">{course.title}</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-300">{course.summary}</p>
    <p class="mt-4 text-sm text-slate-400">
      Board: <span class="font-mono text-slate-200">{course.board}</span>
      {course.based_on && (
        <> · Based on <a class="text-accent hover:underline" href={course.based_on}>{course.based_on.replace('https://github.com/', '')}</a></>
      )}
    </p>
  </section>

  <ol class="grid gap-3">
    {course.modules.map((m, i) => {
      const available = m.access === 'free' && m.status !== 'planned';
      const inner = (
        <div class="flex items-center gap-4">
          <span class="w-8 font-mono text-slate-500">{String(i + 1).padStart(2, '0')}</span>
          <span class={`flex-1 font-medium ${available ? 'text-white' : 'text-slate-400'}`}>{m.title}</span>
          {m.access === 'free'
            ? <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-semibold text-accent">Free</span>
            : <span class="rounded-full bg-warn/15 px-2.5 py-0.5 text-xs font-semibold text-warn">Full course</span>}
          {m.status === 'planned' && <span class="text-xs text-slate-500">coming soon</span>}
        </div>
      );
      return (
        <li>
          {available
            ? <a href={`/courses/${course.id}/${m.id}`} class="block rounded-lg border border-line bg-panel p-4 hover:border-accent-dim">{inner}</a>
            : <div class="rounded-lg border border-line/60 p-4">{inner}</div>}
        </li>
      );
    })}
  </ol>

  <section class="mt-12 rounded-lg border border-warn/30 bg-warn/5 p-6">
    <h2 class="font-semibold text-white">The full course</h2>
    <p class="mt-2 text-sm text-slate-300">
      Modules 3 to 8 take the mini OS from serial output to an LCD terminal, interrupts,
      a preemptive scheduler and a shell. They will be part of the paid course.
    </p>
    <a href={`/courses/${course.id}/01-blinky`} class="mt-4 inline-block rounded-md bg-accent px-4 py-2 text-sm font-semibold text-ink">Start module 1 for free</a>
  </section>
</Base>
